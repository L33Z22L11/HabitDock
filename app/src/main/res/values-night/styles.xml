<resources>
    <style name="BaseAppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorPrimaryContainer">@color/soft</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>
        <item name="colorSecondaryContainer">@color/soft</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>
        <item name="colorSurface">@color/page</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerLowest">@color/page</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/soft</item>
        <item name="colorSurfaceDim">@color/page</item>
        <item name="colorSurfaceBright">@color/surface</item>
        <item name="colorSurfaceVariant">@color/soft</item>
        <item name="colorOutline">@color/muted</item>
        <item name="colorOnSecondary">@color/page</item>
        <item name="colorTertiary">@color/accent</item>
        <item name="colorOnTertiary">@color/page</item>
        <item name="colorTertiaryContainer">@color/soft</item>
        <item name="colorOnTertiaryContainer">@color/ink</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="colorControlNormal">?attr/colorOnSurfaceVariant</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutlineVariant">@color/stroke</item>
        <item name="android:colorAccent">?attr/colorPrimary</item>
        <item name="android:colorControlActivated">?attr/colorPrimary</item>
        <item name="android:colorControlNormal">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="android:scrollbarThumbVertical">@drawable/scrollbar_thumb</item>
        <item name="android:scrollbarThumbHorizontal">@drawable/scrollbar_thumb</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">#101615</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppTheme" parent="BaseAppTheme" />
</resources>
